# --- Keitaro ---
KEITARO_BASE_URL=https://tlgk.host/admin_api/v1
KEITARO_API_KEY=put-your-api-key-here

# Значения по умолчанию для создаваемых кампаний (тестовый аккаунт «Это Легко»)
DEFAULT_DOMAIN_ID=1813
DEFAULT_GROUP_ID=9799
