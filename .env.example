# Префикс имён кампаний по ТЗ (test_<фамилия>_)
CAMPAIGN_PREFIX=test_vorobev_

# Куда редиректит поток №1
GOOGLE_URL=https://www.google.com/

# --- База ---
DATABASE_URL=sqlite:///./keitaro_wrapper.sqlite3
DICTIONARY_TTL_SECONDS=600
